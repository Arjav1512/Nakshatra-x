# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here

# Resend Email Verification (Optional — dev OTP fallback active by default)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Session signing (REQUIRED in production)
# ---------------------------------------------------------------------------
# Session and admin cookies are HMAC-signed with this key. Without it the app
# refuses to issue sessions in production rather than signing with a guessable
# default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# FastAPI service layer
# ---------------------------------------------------------------------------
# The Next.js /api/v1/* routes proxy to this. All headline-number computation
# lives there (see SIH26009-Architecture.excalidraw, layer L4). If unset the
# app defaults to http://127.0.0.1:8000 for local development; if the backend
# is unreachable the UI degrades and says so rather than substituting values.
BACKEND_URL=http://127.0.0.1:8000
