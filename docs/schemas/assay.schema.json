{
  "description": "A downhole assay interval. Many rows per borehole.",
  "properties": {
    "contract_version": {
      "default": "1.0.0",
      "description": "Schema version this row was written under.",
      "title": "Contract Version",
      "type": "string"
    },
    "is_synthetic": {
      "description": "True for generator output, False for data supplied by MOIL. Required \u2014 there is no default, so a producer must state it.",
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "source": {
      "description": "Where the row came from, e.g. 'nakshatra-synthetic-v1' or 'MOIL CMMS export 2026-03'.",
      "title": "Source",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "borehole_id": {
      "maxLength": 64,
      "title": "Borehole Id",
      "type": "string"
    },
    "from_depth_m": {
      "maximum": 2000,
      "minimum": 0,
      "title": "From Depth M",
      "type": "number"
    },
    "to_depth_m": {
      "exclusiveMinimum": 0,
      "maximum": 2000,
      "title": "To Depth M",
      "type": "number"
    },
    "mn_pct": {
      "maximum": 100,
      "minimum": 0,
      "title": "Mn Pct",
      "type": "number"
    },
    "fe_pct": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fe Pct"
    },
    "sio2_pct": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sio2 Pct"
    },
    "p_pct": {
      "anyOf": [
        {
          "maximum": 20,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "P Pct"
    },
    "al2o3_pct": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Al2O3 Pct"
    },
    "recovery_pct": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recovery Pct"
    },
    "assay_method": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assay Method"
    }
  },
  "required": [
    "is_synthetic",
    "source",
    "borehole_id",
    "from_depth_m",
    "to_depth_m",
    "mn_pct"
  ],
  "title": "Assay",
  "type": "object"
}
