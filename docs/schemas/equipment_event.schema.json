{
  "description": "HEMM availability and downtime (PRD B-2). One row per event, not a daily\nroll-up, so MTBF/MTTR are derivable.",
  "properties": {
    "contract_version": {
      "default": "1.0.0",
      "description": "Schema version this row was written under.",
      "title": "Contract Version",
      "type": "string"
    },
    "is_synthetic": {
      "description": "True for generator output, False for data supplied by MOIL. Required \u2014 there is no default, so a producer must state it.",
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "source": {
      "description": "Where the row came from, e.g. 'nakshatra-synthetic-v1' or 'MOIL CMMS export 2026-03'.",
      "title": "Source",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "mine_code": {
      "maxLength": 32,
      "title": "Mine Code",
      "type": "string"
    },
    "equipment_id": {
      "maxLength": 64,
      "title": "Equipment Id",
      "type": "string"
    },
    "equipment_type": {
      "enum": [
        "shovel",
        "excavator",
        "dumper",
        "loader",
        "drill",
        "crusher",
        "conveyor",
        "pump",
        "other"
      ],
      "title": "Equipment Type",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "breakdown",
        "scheduled_maintenance",
        "idle",
        "operating"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "downtime_hours": {
      "anyOf": [
        {
          "maximum": 8760,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Downtime Hours"
    },
    "failure_mode": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Mode"
    }
  },
  "required": [
    "is_synthetic",
    "source",
    "mine_code",
    "equipment_id",
    "equipment_type",
    "event_type",
    "started_at"
  ],
  "title": "EquipmentEvent",
  "type": "object"
}
