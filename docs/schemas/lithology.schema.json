{
  "description": "A logged lithological interval.",
  "properties": {
    "contract_version": {
      "default": "1.0.0",
      "description": "Schema version this row was written under.",
      "title": "Contract Version",
      "type": "string"
    },
    "is_synthetic": {
      "description": "True for generator output, False for data supplied by MOIL. Required \u2014 there is no default, so a producer must state it.",
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "source": {
      "description": "Where the row came from, e.g. 'nakshatra-synthetic-v1' or 'MOIL CMMS export 2026-03'.",
      "title": "Source",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "borehole_id": {
      "maxLength": 64,
      "title": "Borehole Id",
      "type": "string"
    },
    "from_depth_m": {
      "maximum": 2000,
      "minimum": 0,
      "title": "From Depth M",
      "type": "number"
    },
    "to_depth_m": {
      "exclusiveMinimum": 0,
      "maximum": 2000,
      "title": "To Depth M",
      "type": "number"
    },
    "rock_type": {
      "description": "e.g. gondite, quartzite, mica-schist",
      "maxLength": 64,
      "title": "Rock Type",
      "type": "string"
    },
    "formation": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "e.g. Sausar Group / Mansar Formation",
      "title": "Formation"
    },
    "weathering": {
      "anyOf": [
        {
          "enum": [
            "fresh",
            "slightly",
            "moderately",
            "highly",
            "completely"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weathering"
    }
  },
  "required": [
    "is_synthetic",
    "source",
    "borehole_id",
    "from_depth_m",
    "to_depth_m",
    "rock_type"
  ],
  "title": "Lithology",
  "type": "object"
}
