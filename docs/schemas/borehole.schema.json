{
  "description": "A drill collar. One row per hole.",
  "properties": {
    "contract_version": {
      "default": "1.0.0",
      "description": "Schema version this row was written under.",
      "title": "Contract Version",
      "type": "string"
    },
    "is_synthetic": {
      "description": "True for generator output, False for data supplied by MOIL. Required \u2014 there is no default, so a producer must state it.",
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "source": {
      "description": "Where the row came from, e.g. 'nakshatra-synthetic-v1' or 'MOIL CMMS export 2026-03'.",
      "title": "Source",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "borehole_id": {
      "maxLength": 64,
      "title": "Borehole Id",
      "type": "string"
    },
    "mine_code": {
      "description": "e.g. MOIL-BAL-01",
      "maxLength": 32,
      "title": "Mine Code",
      "type": "string"
    },
    "latitude": {
      "maximum": 90,
      "minimum": -90,
      "title": "Latitude",
      "type": "number"
    },
    "longitude": {
      "maximum": 180,
      "minimum": -180,
      "title": "Longitude",
      "type": "number"
    },
    "easting_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Northing/easting in EPSG:32644.",
      "title": "Easting M"
    },
    "northing_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Northing M"
    },
    "collar_elevation_m": {
      "maximum": 9000,
      "minimum": -500,
      "title": "Collar Elevation M",
      "type": "number"
    },
    "total_depth_m": {
      "exclusiveMinimum": 0,
      "maximum": 2000,
      "title": "Total Depth M",
      "type": "number"
    },
    "azimuth_deg": {
      "anyOf": [
        {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Azimuth Deg"
    },
    "dip_deg": {
      "anyOf": [
        {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dip Deg"
    },
    "drilled_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Drilled On"
    }
  },
  "required": [
    "is_synthetic",
    "source",
    "borehole_id",
    "mine_code",
    "latitude",
    "longitude",
    "collar_elevation_m",
    "total_depth_m"
  ],
  "title": "Borehole",
  "type": "object"
}
